{
  "expo": {
    "name": "MeMark",
    "slug": "memark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memark",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memark.app",
      "infoPlist": {
        "NSUserActivityTypes": ["NSUserActivityTypeBrowsingWeb"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["memark"]
          }
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
