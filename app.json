{
  "expo": {
    "name": "MeMark",
    "slug": "memark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/copy_of_memark_(2).png",
    "scheme": "memark",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/copy_of_memark.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B5CF6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memark.app",
      "infoPlist": {
        "NSUserActivityTypes": ["NSUserActivityTypeBrowsingWeb"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["memark"]
          }
        ],
        "NSExtension": {
          "NSExtensionAttributes": {
            "NSExtensionActivationRule": {
              "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
              "NSExtensionActivationSupportsText": true
            }
          }
        },
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.memark.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/copy_of_memark_(2).png",
        "backgroundColor": "#8B5CF6"
      },
      "permissions": ["NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "scheme": "http"
            },
            {
              "scheme": "https"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/copy_of_memark_(2).png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/copy_of_memark_(2).png",
          "color": "#8B5CF6"
        }
      ],
      "react-native-gesture-handler",
      "react-native-reanimated",
      "react-native-screens",
      "react-native-safe-area-context"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
